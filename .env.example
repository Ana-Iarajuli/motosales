# Copy to .env for local runs (never commit .env). On Netlify set the same names under
# Site configuration → Environment variables.

# Supabase → Project Settings → API Keys (and Data API for the URL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# server-side only (used by /api/login for username logins) — keep secret
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: RevZilla via Apify (paid)
# APIFY_TOKEN=
